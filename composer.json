  "require": {
    "php": "^8.2",
    "league/flysystem": "^3.35.3",
    "league/flysystem-aws-s3-v3": "^3.30",
    "symfony/filesystem": "^7.4.23",
    "denosyscore/container": "^0.2.2 || ^1.0.0",
